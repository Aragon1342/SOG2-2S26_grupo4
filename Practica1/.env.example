# Configuración de Conexión a Base de Datos en la Nube (PostgreSQL / Neon / Supabase / Railway / AWS RDS / MySQL)
# Ejemplo PostgreSQL / Supabase / Neon:
# DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-1.aws.neon.tech/neondb?sslmode=require

# Ejemplo MySQL / Aiven / PlanetScale:
# DATABASE_URL=mysql+pymysql://usuario:password@host:port/database

# Para pruebas locales sin nube (SQLite):
# DATABASE_URL=sqlite:///practica1_local.db

DATABASE_URL=

# --- Agente conversacional (MCP Server + Google ADK) ---
# API key de Google AI Studio (gratuita con límite de tokens)
GOOGLE_API_KEY=
MODELO=gemini-3.6-flash
