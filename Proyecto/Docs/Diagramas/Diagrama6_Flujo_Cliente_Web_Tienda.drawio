  <diagram id="diag6" name="6. Flujo del Cliente Web y Tienda">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1410" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d6_s" value="Inicio: El cliente decide comprar&#xa;en QuetzalMart" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="20" width="320" height="56" as="geometry" /></mxCell>
        <mxCell id="d6_d0" value="¿Compra en línea o&#xa;en tienda física?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_w1" value="Ingresa a quetzalmart.store (campaña con&#xa;UTM, correo o directo) · GA4: page_view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="230" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_w2" value="Navega el catálogo y filtra&#xa;por categoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="330" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d6_w3" value="Abre la ficha de un producto&#xa;GA4: view_item" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d6_dw1" value="¿Le interesa&#xa;el producto?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="510" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_w4" value="Agrega el producto al carrito&#xa;GA4: add_to_cart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="630" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d6_dw2" value="¿Continúa al pago?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="720" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_a1" value="Carrito abandonado: el pedido&#xa;queda como cotización en Odoo&#xa;y entra a la audiencia GA4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="720" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_a2" value="Fin sin compra" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="840" width="200" height="46" as="geometry" /></mxCell>
        <mxCell id="d6_w5" value="Inicia el pago&#xa;GA4: begin_checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="840" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d6_dw3" value="¿Tiene cuenta o&#xa;desea registrarse?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="155" y="930" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_r1" value="Inicia sesión o se registra&#xa;(portal de clientes de Odoo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="940" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_w6" value="Compra como invitado: ingresa&#xa;nombre, correo y dirección" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1050" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d6_w7" value="Elige el método de envío (Envío estándar&#xa;Q 25); el carrito suma IVA 12 % y envío" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1150" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_w8" value="Paga con el proveedor de pago&#xa;(modo de prueba)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1250" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d6_dw4" value="¿Pago aprobado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="1340" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_e1" value="Error de pago: el cliente&#xa;puede reintentar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1350" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_w9" value="Página de confirmación del pedido&#xa;GA4: purchase (valor, moneda, productos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1460" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_t1" value="Llega a una sucursal&#xa;(Guatemala, México o El Salvador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="230" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_t2" value="Recorre los pasillos y toma&#xa;los productos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d6_dt1" value="¿Encuentra el producto&#xa;en el anaquel?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="420" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_ts1" value="Un colaborador revisa existencias&#xa;en Inventario de Odoo y lo repone&#xa;desde bodega o sugiere un sustituto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="425" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="d6_t3" value="Pasa a caja: el cajero registra los&#xa;productos en una orden de venta (Odoo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_dt2" value="¿El cliente está&#xa;registrado en Odoo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="660" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_ts2" value="Se crea el contacto del cliente&#xa;(nombre, NIT o CF, correo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="670" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_t4" value="Se calcula el total con IVA 12 %&#xa;y se confirma la orden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="790" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_t5" value="El cliente paga en caja&#xa;(efectivo o tarjeta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="890" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d6_dt3" value="¿Pago aprobado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="980" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_ts3" value="Pago rechazado: intenta&#xa;otro método de pago" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="990" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_t6" value="Se empacan los productos&#xa;en caja" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="1100" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="d6_c1" value="Odoo confirma la venta y genera la factura&#xa;(Ventas → Facturación)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1580" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_c2" value="Inventario: salida de los productos del almacén;&#xa;la cantidad a la mano se actualiza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1680" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_dc" value="¿La compra fue&#xa;en línea?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="465" y="1780" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="d6_cw1" value="Se empaca el pedido y se entrega&#xa;a domicilio (envío estándar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1890" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_cw2" value="Correo al cliente: confirmación&#xa;del pedido y factura en PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1990" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_cw3" value="Automatización de marketing: correo&#xa;de campaña con asunto distinto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="2090" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_ct1" value="Se entregan los productos y la&#xa;factura impresa en caja" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="1890" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="d6_c3" value="El cliente queda en Contactos (CRM) con su&#xa;historial de compras para futuras campañas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="2220" width="380" height="60" as="geometry" /></mxCell>
