    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="Para cada archivo en carpetas" sap2010:WorkflowViewState.IdRef="ForEach`1_2" Values="[System.IO.Directory.GetFiles(in_RutaEntrada, &quot;*.*&quot;, System.IO.SearchOption.AllDirectories)]">
